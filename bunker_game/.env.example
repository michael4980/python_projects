# Скопируйте в .env (не коммитится) или задайте в панели хостинга.
MASTER_CODE=            # без него создать комнату может кто угодно
OPENAI_API_KEY=         # ключ OpenAI для художественной хроники (необязательно)
OPENAI_MODEL=gpt-4o-mini
ROOM_TTL_HOURS=8
REDIS_URL=              # Redis для хранения комнат между перезапусками; без него — файл в DATA_DIR
DATA_DIR=data
